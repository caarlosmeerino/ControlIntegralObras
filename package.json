{
  "name": "control-integral-obras",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de fabricación y montaje de estructuras metálicas",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "restaurar": "node scripts/restaurar.js",
    "iconos": "node scripts/iconos.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
