# --- Obligatorias en producción ---
DATABASE_URL=postgres://usuario:contraseña@host:5432/base     # En Railway: ${{Postgres.DATABASE_URL}}
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
NODE_ENV=production

# --- Administrador inicial (solo se crea si no hay usuarios) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=una-contraseña-segura
ADMIN_NOMBRE=Administrador

# --- Almacenamiento de fotos, planos y copias ---
# Opción A: Volumen de Railway montado en /data
UPLOAD_DIR=/data
# Opción B: bucket compatible S3 (Railway Buckets, Cloudflare R2, AWS S3...)
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_FILE_MB=25

# --- Copias e informes automáticos ---
BACKUP_ENABLED=true
BACKUP_CRON=30 2 * * *
BACKUP_KEEP=14
REPORTS_CRON=0 6 * * *
TZ=Europe/Madrid
SESSION_HOURS=12
# PUBLIC_URL=https://obras.miempresa.es   # para los QR; si no, se usa el dominio de Railway

# --- Direcciones con Google Maps (opcional) ---
# Clave de Google Cloud con «Places API (New)» activada. Sin ella se usa CartoCiudad (IGN).
# GOOGLE_MAPS_API_KEY=
